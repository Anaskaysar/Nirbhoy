# Environment variables read by config/settings.py.
# Local development uses built-in defaults, so none are required.
# Production values on Render are defined in render.yaml.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=nirbhoy.kaysarulanas.me
DJANGO_CSRF_TRUSTED_ORIGINS=https://nirbhoy.kaysarulanas.me

# Encryption key for report text (any long random string works).
FIELD_ENCRYPTION_KEY=
# Key for hashing receipt codes.
RECEIPT_HASH_KEY=

# Optional: superuser for the Django admin, created on startup by seed_demo.
DJANGO_ADMIN_USERNAME=
DJANGO_ADMIN_PASSWORD=
